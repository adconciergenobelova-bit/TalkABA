{
  "name": "talk-aba",
  "private": true,
  "version": "1.0.0",
  "description": "Talk ABA - static HTML/CSS/JS site with optional PHP API",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --watch",
    "serve": "php -S localhost:8080"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "tailwindcss": "^4.2.1"
  }
}
